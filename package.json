{
  "name": "adirector",
  "version": "1.0.0",
  "description": "Multi-camera LAN WebRTC video production system for Desktop and Mobile",
  "private": true,
  "type": "module",
  "main": "desktop-app/electron/main.js",
  "scripts": {
    "build": "node scripts/build.js",
    "build:server": "tsc -p server/tsconfig.json",
    "dev:server": "tsx watch server/src/server.ts",
    "dev:app": "node scripts/build.js && electron desktop-app/electron/main.js",
    "start:server": "tsx server/src/server.ts",
    "start:app": "electron desktop-app/electron/main.js",
    "server": "tsx server/src/server.ts",
    "app": "electron desktop-app/electron/main.js",
    "start": "node scripts/build.js && node -e \"const { spawn } = require('child_process'); spawn('npx', ['tsx', 'server/src/server.ts'], { stdio: 'inherit' }); setTimeout(() => spawn('npx', ['electron', 'desktop-app/electron/main.js'], { stdio: 'inherit' }), 1200);\"",
    "dev": "node scripts/build.js && node -e \"const { spawn } = require('child_process'); spawn('npx', ['tsx', 'server/src/server.ts'], { stdio: 'inherit' }); setTimeout(() => spawn('npx', ['electron', 'desktop-app/electron/main.js'], { stdio: 'inherit' }), 1200);\"",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "com.adirector.studio",
    "productName": "ADirector Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop-app/electron/main.js",
      "desktop-app/electron/main.cjs",
      "desktop-app/electron/preload.js",
      "desktop-app/electron/preload.cjs",
      "desktop-app/dist/**/*",
      "desktop-app/assets/**/*",
      "server/**/*",
      "mobile-web/public/**/*",
      "types/**/*"
    ],
    "mac": {
      "icon": "desktop-app/assets/icon.png",
      "category": "public.app-category.video",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "desktop-app/assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "desktop-app/assets/icon.ico",
      "uninstallerIcon": "desktop-app/assets/icon.ico",
      "installerHeaderIcon": "desktop-app/assets/icon.ico"
    },
    "linux": {
      "icon": "desktop-app/assets/icon.png",
      "category": "AudioVideo",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "selfsigned": "^2.4.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.5.13",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
